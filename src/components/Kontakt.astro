---
---
<section id="dmk-sec6-wrap" style="margin-top:0!important;padding-top:0!important;background:transparent;">
<section aria-labelledby="dmk-sec6-title" data-dmk="6" id="dmk-sec6">
  <div class="wrap">
    <div class="container">
      <header class="head" style="margin:0 0 18px 0;">
        <h3 id="dmk-sec6-title">
          <span class="title-main">Lassen Sie uns Ihr Projekt besprechen.</span>
          <span class="title-sub">Wir sind bereit – Sie auch?</span>
        </h3>
        <p class="lead">
          Kostenlose Erstberatung – persönlich, transparent und fair.
          Auf Wunsch kommen wir zu Ihnen nach <strong>Reichelsheim</strong> und in den Odenwald.
        </p>
      </header>

      <div class="grid">
        <!-- Linke Karte: Kontakt + Karte -->
        <aside aria-label="Kontakt &amp; Standort" class="card cta">
          <h4>Direktkontakt</h4>

          <div class="phones">
            <div class="phone-cta">
              <svg aria-hidden="true" class="ico" fill="none" stroke="currentColor"
                   stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.1 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.86.32 1.7.59 2.5a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.58-1.16a2 2 0 0 1 2.11-.45c.8.27 1.64.47 2.5.59A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <a aria-label="Jetzt anrufen: 0160 7791280" href="tel:01607791280">0160 7791280</a>
            </div>
            <div class="phone-cta">
              <svg aria-hidden="true" class="ico" fill="none" stroke="currentColor"
                   stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.1 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.86.32 1.7.59 2.5a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.58-1.16a2 2 0 0 1 2.11-.45c.8.27 1.64.47 2.5.59A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <a aria-label="Jetzt anrufen: 06164 5039805" href="tel:061645039805">06164 5039805</a>
            </div>
          </div>

          <ul class="bullets dmk-feats" role="list">
            <li>
              <span aria-hidden="true">
                <svg fill="none" stroke="#369142" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" viewBox="0 0 24 24">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <span>Unverbindliche Erstberatung mit Festpreis-Angebot</span>
            </li>
            <li>
              <span aria-hidden="true">
                <svg fill="none" stroke="#369142" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" viewBox="0 0 24 24">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <span>Vor-Ort-Termin im Odenwald &amp; Umgebung</span>
            </li>
            <li>
              <span aria-hidden="true">
                <svg fill="none" stroke="#369142" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" viewBox="0 0 24 24">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <span>Fördermittel-Check (KfW/BAFA) möglich</span>
            </li>
          </ul>

          <!-- Google Maps – DSGVO-konform: erst nach Klick laden -->
          <div aria-label="Standort DMK Bau" class="map">
            <div class="bar">
              <div class="addr">
                <svg aria-hidden="true" class="ico" fill="none" stroke="currentColor"
                     stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24">
                  <path d="M21 10c0 7-9 12-9 12S3 17 3 10a9 9 0 1 1 18 0Z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                DMK Bau, Heidelberger Str. 5, 64385 Reichelsheim (Odenwald)
              </div>
              <a class="open-maps" href="https://maps.app.goo.gl/DD78znm6A7x9XRAb9"
                 rel="noopener" target="_blank">In Google Maps öffnen</a>
            </div>

            <!-- Consent-Gate: Karte erst nach Klick einblenden -->
            <div class="canvas" id="mapCanvas">
              <div class="map-placeholder" id="mapPlaceholder">
                <svg aria-hidden="true" fill="none" stroke="#369142" stroke-width="1.5"
                     stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                  <path d="M21 10c0 7-9 12-9 12S3 17 3 10a9 9 0 1 1 18 0Z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <p>Heidelberger Straße 5<br />64385 Reichelsheim (Odenwald)</p>
                <!-- DSGVO: Google Maps iframe wird erst nach Klick geladen -->
                <button class="btn-load-map" id="btnLoadMap" type="button">
                  Karte laden
                  <svg aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
                       stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </button>
                <span class="map-note">Google Maps wird nach Klick geladen (externe Verbindung)</span>
              </div>
            </div>
          </div>
        </aside>

        <!-- Rechte Karte: Formular -->
        <div aria-label="Kontaktformular" class="card form-card">
          <div class="alert ok" hidden id="c6-ok" role="status">Vielen Dank! Wir melden uns zeitnah.</div>
          <div class="alert err" hidden id="c6-err" role="status">Bitte prüfen Sie Ihre Eingaben.</div>

          <!-- Anker für direkte Verlinkung -->
          <a id="kontaktformular" style="position:relative;top:-80px;display:block;"></a>

          <form id="dmk-form" novalidate>
            <!-- DSGVO: Formular-Endpoint kommt später; Submit zeigt Erfolgs-Popup -->
            <div class="fieldset">
              <div class="ctrl">
                <label for="c6-name">Ihr Name*</label>
                <input autocomplete="name" id="c6-name" name="name" required type="text" />
              </div>
              <div class="ctrl">
                <label for="c6-phone">Telefon*</label>
                <input autocomplete="tel" id="c6-phone" inputmode="tel" name="phone" required type="tel" />
              </div>
              <div class="ctrl row-2">
                <label for="c6-email">E-Mail</label>
                <input autocomplete="email" id="c6-email" name="email" placeholder="optional" type="email" />
              </div>
              <div class="ctrl row-2">
                <label for="c6-plzort">PLZ &amp; Ort*</label>
                <input id="c6-plzort" name="plz_ort" required type="text" placeholder="z. B. 64720 Michelstadt" />
              </div>
              <div class="ctrl row-2">
                <label for="c6-str">Straße &amp; Hausnummer*</label>
                <input id="c6-str" name="strasse" autocomplete="address-line1" required type="text"
                       placeholder="Straße und Hausnummer" />
              </div>
              <div class="ctrl row-2">
                <label for="c6-msg">Ihre Nachricht*</label>
                <textarea id="c6-msg" name="message" placeholder="Wie können wir Sie unterstützen?" required></textarea>
              </div>

              <!-- Honeypot -->
              <input aria-hidden="true" autocomplete="off" id="c6-company" name="company"
                     style="position:absolute;left:-9999px;" tabindex="-1" type="text" />

              <div class="row-2 consent">
                <input id="c6-accept" required type="checkbox" />
                <label for="c6-accept">Ich stimme zu, dass meine Angaben zur Kontaktaufnahme und Rückfrage gespeichert werden. (Datenschutz)</label>
              </div>
              <div class="row-2 actions">
                <button class="btn-green" type="submit">
                  <svg class="ico" fill="none" stroke="currentColor" stroke-linecap="round"
                       stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24"
                       style="color:#fff;width:18px;height:18px">
                    <path d="m22 2-7 20-4-9-9-4 20-7z"></path>
                    <path d="M22 2 11 13"></path>
                  </svg>
                  Anfrage senden
                </button>
                <span class="note">* Pflichtfelder</span>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
</section>

<!-- Erfolgs-Popup -->
<div id="dmk-success-popup" role="dialog" aria-modal="true" aria-label="Nachricht gesendet">
  <div class="box">
    <h3>Vielen Dank!</h3>
    <p>Wir haben Ihre Nachricht erhalten und melden uns in Kürze bei Ihnen.</p>
    <button type="button" id="popupClose">Schließen</button>
  </div>
</div>

<style>
  #dmk-sec6[data-dmk="6"] {
    --brand: #369142; --brand-2: #2B7A37;
    --ink: #202420; --muted: #5e6a63; --ring: #e8efea;
    --radius: 16px; --shadow: 0 8px 28px rgba(0,0,0,.06);
    font-family: "Quicksand", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
    background: linear-gradient(180deg, #ffffff 0%, #f8fbf9 100%);
    color: var(--ink);
    overflow-x: hidden;
  }

  #dmk-sec6 .wrap { width: 100%; margin: 0 auto; padding: 70px 24px 90px; }
  @media (max-width: 900px) { #dmk-sec6 .wrap { padding: 50px 18px 80px; } }
  #dmk-sec6 .container { max-width: 1440px; margin: 0 auto; }

  /* Headline */
  #dmk-sec6-title {
    margin: 0 0 8px;
    line-height: 1.12;
    letter-spacing: .1px;
    font-size: clamp(26px, 4vw, 38px);
    font-weight: 600;
    color: var(--ink);
  }
  #dmk-sec6-title .title-main { display: block; color: var(--brand); font-weight: 600; }
  #dmk-sec6-title .title-sub  { display: block; margin-top: 2px; font-weight: 500; color: #2E6C3A; }
  @media (max-width: 520px) { #dmk-sec6-title .title-sub { font-size: calc(1em - 1px); } }

  #dmk-sec6 .lead {
    color: #334134; font-weight: 500;
    font-size: clamp(15px, 1vw + 12px, 16.5px);
    line-height: 1.65; margin: 0; max-width: 72ch;
  }

  /* Grid */
  #dmk-sec6 .grid { display: grid; gap: 18px; grid-template-columns: 1fr; }
  @media (min-width: 980px) { #dmk-sec6 .grid { grid-template-columns: 1.05fr .95fr; } }

  /* Animation */
  @keyframes fadeUp6 { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }
  #dmk-sec6 .grid > * { animation: fadeUp6 .6s cubic-bezier(.2,.7,.2,1) both; }

  /* Cards */
  #dmk-sec6 .card { border: 1px solid var(--ring); border-radius: var(--radius); background: transparent; box-shadow: var(--shadow); }

  /* CTA-Karte */
  #dmk-sec6 .cta { padding: 22px; }
  #dmk-sec6 .cta h4 { font-weight: 600; font-size: 19px; line-height: 1.25; margin: 0 0 10px; color: #263726; }

  /* Telefone */
  #dmk-sec6 .phones { display: grid; gap: 10px; margin: 0 0 12px; grid-template-columns: 1fr; }
  @media (min-width: 520px) { #dmk-sec6 .phones { grid-template-columns: 1fr 1fr; } }
  #dmk-sec6 .phone-cta {
    display: flex; align-items: center; gap: 10px; padding: 12px 14px;
    border: 1px solid #e3eee6; border-radius: 14px;
    background: linear-gradient(180deg, #f5fbf7, #eef6f0);
  }
  #dmk-sec6 .phone-cta a { text-decoration: none; color: #1f2e20; font-weight: 600; font-size: 17px; letter-spacing: .1px; }
  #dmk-sec6 .ico { width: 19px; height: 19px; flex: 0 0 19px; color: var(--brand); }

  /* Bullets */
  #dmk-sec6 .bullets { list-style: none; display: grid; gap: 7px; margin: 6px 0 14px; padding: 0; }
  #dmk-sec6 .bullets li { display: flex; gap: 9px; align-items: flex-start; font-weight: 500; color: #2b392c; }
  #dmk-sec6 .bullets li > span:first-child svg { width: 18px; height: 18px; }

  /* Map */
  #dmk-sec6 .map { margin-top: 6px; border: 1px solid #e6efe9; border-radius: 14px; overflow: hidden; background: transparent; }
  #dmk-sec6 .map .bar {
    display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 12px;
    background: linear-gradient(90deg, rgba(54,145,66,.06), rgba(43,122,55,.03));
    border-bottom: 1px solid #e7efe9;
  }
  #dmk-sec6 .map .addr { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; font-weight: 500; font-size: 13.5px; color: #223321; }
  #dmk-sec6 .map .addr .ico { width: 18px; height: 24px; }
  #dmk-sec6 .map .open-maps {
    margin-left: auto; font-weight: 600; font-size: 12.5px; color: #1e3a22;
    text-decoration: none; border: 1px solid #e2ede6; padding: 6px 10px;
    border-radius: 10px; background: #f3f8f5; white-space: nowrap;
  }
  #dmk-sec6 .canvas { aspect-ratio: 16/9; background: #eef5ef; position: relative; }
  #dmk-sec6 .canvas iframe { width: 100%; height: 100%; border: 0; display: block; }

  /* Map Placeholder */
  .map-placeholder {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 10px; background: #f0f7f1; color: #3a5a40; text-align: center; padding: 16px;
  }
  .map-placeholder svg { width: 40px; height: 40px; opacity: .7; }
  .map-placeholder p { font-size: 14px; font-weight: 600; line-height: 1.5; color: #2a3c2b; margin: 0; }
  .btn-load-map {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--brand); color: #fff; border: 0; border-radius: 10px;
    padding: 10px 16px; font-weight: 700; font-size: 14px; cursor: pointer;
    font-family: inherit; transition: filter .2s, transform .15s;
    box-shadow: 0 4px 14px rgba(54,145,66,.28);
  }
  .btn-load-map svg { width: 16px; height: 16px; }
  .btn-load-map:hover { filter: brightness(.95); transform: translateY(-1px); }
  .map-note { font-size: 11.5px; color: #6b7a6c; font-weight: 500; }

  /* Formular */
  #dmk-sec6 .form-card { padding: 18px; }
  #dmk-sec6 .fieldset { display: grid; gap: 12px; grid-template-columns: 1fr; }
  @media (min-width: 640px) { #dmk-sec6 .fieldset { grid-template-columns: 1fr 1fr; } }
  .row-2 { grid-column: 1 / -1; }
  #dmk-sec6 .ctrl { display: flex; flex-direction: column; gap: 6px; }
  #dmk-sec6 label { font-weight: 500; font-size: 13.5px; color: #2a392a; }
  #dmk-sec6 input, #dmk-sec6 textarea {
    width: 100%; border: 1px solid var(--ring); border-radius: 12px; padding: 12px;
    font: 500 15px/1.4 Quicksand, system-ui, sans-serif;
    background: transparent; color: #1f1f1f;
    transition: border-color .2s, box-shadow .2s;
  }
  #dmk-sec6 textarea { min-height: 120px; resize: vertical; }
  #dmk-sec6 input:focus, #dmk-sec6 textarea:focus {
    outline: none; border-color: #d5e7dc; box-shadow: 0 0 0 3px rgba(54,145,66,.10);
  }
  #dmk-sec6 .consent { display: flex; gap: 10px; align-items: flex-start; font-weight: 500; color: #2b3c2b; font-size: 13.5px; }
  #dmk-sec6 .consent input { width: 18px; height: 24px; margin-top: 2px; }
  #dmk-sec6 .actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  #dmk-sec6 .btn-green {
    background: var(--brand); color: #fff; text-decoration: none; border: 0; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    padding: 14px 22px; border-radius: 14px; font-weight: 700; font-size: 16px;
    box-shadow: 0 6px 20px rgba(54,145,66,.22); transition: transform .15s, filter .2s;
    font-family: inherit;
  }
  #dmk-sec6 .btn-green:hover { filter: brightness(.98); transform: translateY(-1px); }
  #dmk-sec6 .note { font-size: 12.5px; color: #6b7a6c; font-weight: 500; }

  /* Alerts */
  #dmk-sec6 .alert { border-radius: 12px; padding: 10px 12px; font-weight: 600; font-size: 14px; margin-bottom: 12px; }
  #dmk-sec6 .alert[hidden] { display: none !important; }
  #dmk-sec6 .alert.ok { background: #e9f6ec; color: #1c3a22; border: 1px solid #cfe7d4; }
  #dmk-sec6 .alert.err { background: #fff2f2; color: #6b1f1f; border: 1px solid #f3d0d0; }

  /* Scroll-Margin */
  #dmk-sec6[data-dmk="6"] { scroll-margin-top: 90px; }

  /* Erfolgs-Popup */
  #dmk-success-popup {
    position: fixed; inset: 0; display: none; align-items: center; justify-content: center;
    background: rgba(0,0,0,.45); z-index: 9999;
  }
  #dmk-success-popup.open { display: flex; }
  #dmk-success-popup .box {
    background: #fff; border-radius: 18px; padding: 28px 26px; max-width: 420px; width: 90%;
    box-shadow: 0 20px 50px rgba(0,0,0,.25); text-align: center;
  }
  #dmk-success-popup h3 { color: #369142; font-size: 22px; margin-bottom: 10px; font-family: Quicksand, sans-serif; }
  #dmk-success-popup p  { color: #333; font-size: 15.5px; line-height: 1.6; font-family: Quicksand, sans-serif; }
  #dmk-success-popup button {
    margin-top: 18px; background: #369142; color: #fff; border: 0;
    padding: 12px 18px; border-radius: 12px; font-weight: 700; cursor: pointer;
    font-family: Quicksand, sans-serif;
  }
</style>

<script>
  // ===== Google Maps Consent-Gate =====
  const btnMap = document.getElementById('btnLoadMap');
  const mapPlaceholder = document.getElementById('mapPlaceholder');
  const mapCanvas = document.getElementById('mapCanvas');

  btnMap?.addEventListener('click', () => {
    const iframe = document.createElement('iframe');
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'no-referrer-when-downgrade';
    iframe.src = 'https://www.google.com/maps?q=DMK%20Bau%2C%20Heidelberger%20Str.%205%2C%2064385%20Reichelsheim%20(Odenwald)&output=embed';
    iframe.title = 'DMK Bau – Heidelberger Str. 5, 64385 Reichelsheim (Odenwald)';
    iframe.style.cssText = 'width:100%;height:100%;border:0;display:block;';
    mapPlaceholder?.remove();
    mapCanvas?.appendChild(iframe);
  });

  // ===== Formular Submit (Platzhalter – echter Endpoint kommt später) =====
  const form    = document.getElementById('dmk-form') as HTMLFormElement | null;
  const okAlert = document.getElementById('c6-ok');
  const errAlert = document.getElementById('c6-err');
  const popup   = document.getElementById('dmk-success-popup');
  const popupClose = document.getElementById('popupClose');
  const hp      = document.getElementById('c6-company') as HTMLInputElement | null;

  function show(el: HTMLElement | null) { el?.removeAttribute('hidden'); }
  function hide(el: HTMLElement | null) { el?.setAttribute('hidden', ''); }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    hide(okAlert); hide(errAlert);

    const name   = (form.querySelector('#c6-name') as HTMLInputElement)?.value.trim();
    const phone  = (form.querySelector('#c6-phone') as HTMLInputElement)?.value.trim();
    const email  = (form.querySelector('#c6-email') as HTMLInputElement)?.value.trim();
    const msg    = (form.querySelector('#c6-msg') as HTMLTextAreaElement)?.value.trim();
    const accept = (form.querySelector('#c6-accept') as HTMLInputElement)?.checked;

    const basicValid = name && phone && msg && accept && !hp?.value;
    const emailValid = !email || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

    if (!basicValid || !emailValid) { show(errAlert); return; }

    // Erfolgs-Popup zeigen (echter Submit kommt später)
    popup?.classList.add('open');
    document.documentElement.style.overflow = 'hidden';
    form.reset();
  });

  popupClose?.addEventListener('click', () => {
    popup?.classList.remove('open');
    document.documentElement.style.overflow = '';
  });
  popup?.addEventListener('click', (e) => {
    if (e.target === popup) {
      popup.classList.remove('open');
      document.documentElement.style.overflow = '';
    }
  });
</script>
