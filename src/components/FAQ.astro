<style>
  #dmk-sec5[data-dmk="5"] {
    --brand: #369142; --brand-2: #2B7A37;
    --ink: #1f1f1f; --muted: #4a5157; --ring: #e2ebe4; --radius: 18px;
    font-family: "Quicksand", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
    background: transparent;
    color: var(--ink);
  }
  #dmk-sec5[data-dmk="5"] .wrap { width: 100%; padding: 70px 18px 84px; }
  #dmk-sec5[data-dmk="5"] .container { width: 100%; max-width: 1440px; margin: 0 auto; }

  #dmk-sec5[data-dmk="5"] .head { max-width: 980px; margin: 0 0 26px 0; }
  #dmk-sec5-title {
    margin: 0 0 10px 0;
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: .2px;
    font-size: clamp(28px, 4vw, 42px);
    background: linear-gradient(90deg, var(--brand), var(--brand-2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  #dmk-sec5[data-dmk="5"] .lead {
    margin: 0;
    color: var(--muted);
    font-weight: 500;
    font-size: clamp(15px, 1vw + 12px, 17px);
    line-height: 1.6;
  }

  /* 2-Spalten-Grid */
  .faq-grid { display: flex; flex-direction: column; gap: 14px; }
  .col { display: flex; flex-direction: column; gap: 14px; }
  @media (min-width: 980px) {
    .faq-grid { flex-direction: row; }
    .col { flex: 1; }
  }

  /* FAQ-Item */
  .item {
    border: 1.5px solid var(--ring);
    border-radius: var(--radius);
    background: transparent;
    box-shadow: 0 6px 18px rgba(0,0,0,.05);
    transition: border-color .2s, box-shadow .2s, transform .08s;
  }
  .item:hover { border-color: #d4e2d8; box-shadow: 0 12px 28px rgba(0,0,0,.09); transform: translateY(-1px); }

  .q {
    width: 100%; border: 0; background: transparent; cursor: pointer;
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    padding: 16px 18px; border-radius: var(--radius); text-align: left;
    font-family: inherit;
  }
  .qt { font-weight: 500; font-size: 16px; line-height: 1.35; color: #213021; letter-spacing: .1px; }

  .ico {
    flex: 0 0 22px; width: 22px; height: 22px;
    color: var(--brand);
    display: inline-grid; place-items: center;
  }
  .ico svg { width: 22px; height: 22px; display: block; }
  .q:hover .ico { color: var(--brand-2); }

  /* CSS Grid Row Trick für sanftes Öffnen */
  .a {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .25s ease, padding .25s ease;
  }
  .a > div { overflow: hidden; }
  .body { padding: 0 18px 0; }
  .item.open .a { grid-template-rows: 1fr; }
  .item.open .body { padding: 0 18px 16px; }
  .a p { margin: 0; color: #2a392a; font-weight: 600; font-size: 14.5px; line-height: 1.65; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('#dmk-sec5[data-dmk="5"] .item').forEach(item => {
    const btn  = item.querySelector<HTMLButtonElement>('.q');
    const plus  = btn?.querySelector<SVGElement>('.plus');
    const minus = btn?.querySelector<SVGElement>('.minus');
    if (!btn) return;

    btn.addEventListener('click', () => {
      const open = item.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
      if (plus)  plus.style.display  = open ? 'none'  : 'block';
      if (minus) minus.style.display = open ? 'block' : 'none';
    });
  });
</script>
