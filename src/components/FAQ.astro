---
const faqs = [
  // Spalte links
  {
    col: 1,
    q: "Wie startet die Zusammenarbeit – was passiert in der Erstberatung?",
    a: "Wir klären Ziel, Budget und Zeitfenster, prüfen Machbarkeit vor Ort und nehmen Aufmaß. Danach erhalten Sie ein <strong>klar strukturiertes Festpreis-Angebot</strong> inkl. Zeitplan."
  },
  {
    col: 1,
    q: "Wie lange dauern Bad, Trockenbau oder Pflasterarbeiten?",
    a: "Die Ausführungszeit hängt vom Umfang und der Komplexität des Projekts ab (Gewerke, Fläche, Material- und Trocknungszeiten). Nach dem Aufmaß erstellen wir gemeinsam mit Ihnen einen detaillierten, realistischen Zeitplan mit klaren Meilensteinen. Dieser wird verbindlich abgestimmt und bei Bedarf transparent aktualisiert – terminsicher und planbar."
  },
  {
    col: 1,
    q: "Unterstützt ihr bei KfW/BAFA-Förderung und Anträgen?",
    a: "Ja. Wir prüfen Förderfähigkeit, stellen die nötigen Unterlagen zusammen und koordinieren auf Wunsch den Antrag mit Energie-Effizienz-Experten."
  },
  {
    col: 1,
    q: "In welchen Orten seid ihr unterwegs?",
    a: "Reichelsheim (Odenwald) und Umfeld: Odenwaldkreis, Reinheim, Michelstadt, Höchst, Brensbach, Erbach, Groß-Bieberau u. a."
  },
  // Spalte rechts
  {
    col: 2,
    q: "Festpreis oder Nachträge – wie kalkuliert DMK Bau?",
    a: "Wir arbeiten bevorzugt mit <strong>Festpreis</strong> basierend auf sauberem Aufmaß und Leistungsbeschreibung. Nur bei <em>zusätzlichen</em> Kundenwünschen oder verdeckten Schäden stimmen wir Nachträge vor Ausführung schriftlich ab."
  },
  {
    col: 2,
    q: "Wie schützt ihr mein Zuhause vor Staub und Schmutz?",
    a: "Staubschutztüren, Abklebungen, Abdeckvlies, Absaugung und tägliche Reinigung der Laufwege gehören zum Standard. Möbel und Böden werden zuverlässig geschützt."
  },
  {
    col: 2,
    q: "Stellt ihr Materialien oder können wir selbst einkaufen?",
    a: "Beides möglich. Wir liefern Markenmaterial inkl. Gewährleistung oder verbauen kundenseitig beigestellte Ware nach Prüfung der Eignung."
  },
  {
    col: 2,
    q: "Welche Gewährleistung erhalte ich?",
    a: "Nach BGB/VOB: <strong>5 Jahre</strong> auf Bauleistungen gemäß gesetzlicher Gewährleistung. Für Produkte gelten die jeweiligen Hersteller-Garantien."
  },
];

const col1 = faqs.filter(f => f.col === 1);
const col2 = faqs.filter(f => f.col === 2);
---

<section aria-labelledby="dmk-sec5-title" data-dmk="5" id="dmk-sec5">
  <div class="wrap">
    <div class="container">
      <div class="head">
        <h3 id="dmk-sec5-title">FAQ – DMK Bau Reichelsheim</h3>
        <p class="lead">Kompakte Antworten zu Ablauf, Kosten, Dauer, Staubschutz, Fördermitteln und Region – mit DMK Bau.</p>
      </div>

      <div class="faq-grid" id="dmk-faq" role="list">
        <!-- Spalte 1 -->
        <div class="col">
          {col1.map((item) => (
            <article class="item" role="listitem">
              <button aria-expanded="false" class="q">
                <span class="qt">{item.q}</span>
                <span aria-hidden="true" class="ico">
                  <svg class="plus" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 5v14M5 12h14"></path>
                  </svg>
                  <svg class="minus" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display:none">
                    <path d="M5 12h14"></path>
                  </svg>
                </span>
              </button>
              <div class="a">
                <div>
                  <div class="body">
                    <p set:html={item.a}></p>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>

        <!-- Spalte 2 -->
        <div class="col">
          {col2.map((item) => (
            <article class="item" role="listitem">
              <button aria-expanded="false" class="q">
                <span class="qt">{item.q}</span>
                <span aria-hidden="true" class="ico">
                  <svg class="plus" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 5v14M5 12h14"></path>
                  </svg>
                  <svg class="minus" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display:none">
                    <path d="M5 12h14"></path>
                  </svg>
                </span>
              </button>
              <div class="a">
                <div>
                  <div class="body">
                    <p set:html={item.a}></p>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

