---
<section class="hero-main" aria-label="Innenausbau Reichelsheim – moderner Wohnraum mit Terrasse">
  <div class="hero-inner">
    <div class="hero-card flow">
      <h1 class="h1-hero">
        <span class="h1-line">
          <span class="brand-text">DMK Bau</span> – Ihr Partner für: Präzisen Innenausbau,
          modernen Trockenbau, hochwertige Badsanierung &amp; gepflegte Außenanlagen.
        </span>
      </h1>

      <p class="hero-lead">
        Das Bauunternehmen DMK Bau ist Ihr Partner für präzisen Innenausbau, modernen Trockenbau,
        hochwertige Badsanierung und gepflegte Außenanlagen. Wir planen und bauen präzise Lösungen –
        vom fugenlosen Bad bis zur kompletten Renovierung – und realisieren Außenarbeiten wie
        Pflasterarbeiten für Einfahrt, Terrasse und Wege im Raum
        <span class="geo">Reichelsheim</span> (<span class="geo">Odenwald</span>).
        Terminsicher, präzise und aus einer Hand.
      </p>

      <p class="claim">Andere sehen Probleme – wir sehen Lösungen.</p>

      <div class="hero-cta">
        <a class="btn-primary" href="/#dmk-sec6">Kostenlose Erstberatung starten</a>
        <a class="btn-ghost" href="tel:01607791280" aria-label="Jetzt anrufen: 0160 7791280">
          <svg aria-hidden="true" fill="none" height="18" stroke="currentColor"
               stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
               viewBox="0 0 24 24" width="18">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6
                     19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.3 1.78.54 2.64
                     a2 2 0 0 1-.45 2.11L8 9a16 16 0 0 0 7 7l.53-1.2a2 2 0 0 1 2.11-.45c.86.24 1.74.42 2.64.54A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span aria-hidden="true">0160 7791280</span>
        </a>
      </div>

      <!-- Trust Badges -->
      <div class="trust-rail" aria-label="Vertrauenssiegel">
        <!-- Google Bewertungen -->
        <div class="trust-badge" role="img"
             aria-label="80 Google-Bewertungen, Durchschnitt 5,0 von 5 Sternen">
          <span class="trust-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="10" fill="white" opacity="0.15"></circle>
              <text x="12" y="16" text-anchor="middle" font-size="12"
                    font-family="system-ui, sans-serif" fill="white">G</text>
            </svg>
          </span>
          <span class="trust-txt">
            <span class="trust-title">
              Top Google-Bewertungen
              <span class="stars" aria-hidden="true">
                <span class="star">★</span><span class="star">★</span><span class="star">★</span>
                <span class="star">★</span><span class="star">★</span>
              </span>
            </span>
            <span class="trust-sub">80 Bewertungen – Ø 5,0 / 5 – verifiziert</span>
            <span class="sr-only">80 Bewertungen, Durchschnitt 5,0 von 5 Sternen</span>
          </span>
        </div>

        <!-- Zertifizierter Fachbetrieb -->
        <div class="trust-badge" role="img"
             aria-label="Zertifizierter Fachbetrieb, Qualität nach Handwerksnorm">
          <span class="trust-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linejoin="round">
              <path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z"/>
              <path d="M9 12l2 2 4-4"/>
            </svg>
          </span>
          <span class="trust-txt">
            <span class="trust-title">Zertifizierter Fachbetrieb</span>
            <span class="trust-sub">Qualität nach Handwerksnorm</span>
          </span>
        </div>

        <!-- Regionale Beratung -->
        <div class="trust-badge" role="img"
             aria-label="Regionale Beratung, direkt bei Ihnen im Odenwald">
          <span class="trust-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2C8.7 2 6 4.7 6 8c0 4.5 3 7.5 6 12 3-4.5 6-7.5 6-12 0-3.3-2.7-6-6-6z"/>
              <circle cx="12" cy="8" r="2.4" fill="white"/>
            </svg>
          </span>
          <span class="trust-txt">
            <span class="trust-title">Regionale Beratung</span>
            <span class="trust-sub">Direkt bei Ihnen im Odenwald</span>
          </span>
        </div>

        <!-- Kostenlose Erstberatung -->
        <div class="trust-badge" role="img"
             aria-label="Kostenlose Erstberatung, unverbindlich und transparent">
          <span class="trust-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 12a8 8 0 0 1 16 0v5a2 2 0 0 1-2 2h-2"/>
              <path d="M4 12v5a2 2 0 0 0 2 2h2"/>
              <rect x="5" y="11" width="3" height="6" rx="1"/>
              <rect x="16" y="11" width="3" height="6" rx="1"/>
            </svg>
          </span>
          <span class="trust-txt">
            <span class="trust-title">Kostenlose Erstberatung</span>
            <span class="trust-sub">Unverbindlich &amp; transparent</span>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ===== Hero Section ===== */
  .hero-main {
    position: relative;
    min-height: 56vh;
    display: flex;
    align-items: center;
    border-bottom: 1px solid #e6e6e6;
    background: #0b0b0b;
  }
  @media (min-width: 1024px) { .hero-main { min-height: 850px; } }

  /* Hintergrundbild */
  .hero-main::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(120% 70% at 80% 50%, rgba(0,0,0,.18) 0%, rgba(0,0,0,0) 60%),
      url("/images/dmk-bau-innenausbau-trockenbau-badsanierung-aussenanlagen-reichelsheim.webp") center/cover no-repeat;
  }

  /* Gradient-Overlay */
  .hero-main::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg,
        rgba(0,0,0,.68) 0%,
        rgba(0,0,0,.50) 28%,
        rgba(0,0,0,.32) 54%,
        rgba(0,0,0,.14) 74%,
        rgba(0,0,0,0) 100%),
      linear-gradient(180deg, rgba(0,0,0,.10) 0%, rgba(0,0,0,0) 35%);
    pointer-events: none;
  }
  @media (max-width: 900px) {
    .hero-main::after {
      background:
        linear-gradient(90deg,
          rgba(0,0,0,.75) 0%,
          rgba(0,0,0,.55) 34%,
          rgba(0,0,0,.34) 60%,
          rgba(0,0,0,.16) 78%,
          rgba(0,0,0,0) 100%),
        linear-gradient(180deg, rgba(0,0,0,.14) 0%, rgba(0,0,0,0) 40%);
    }
  }

  /* Inner – linker Einzug */
  .hero-inner {
    width: 100%;
    margin: 0;
    padding: 64px 18px 64px 200px;
    position: relative;
    z-index: 2;
  }
  @media (max-width: 1200px) { .hero-inner { padding-left: 140px; } }
  @media (max-width: 900px)  { .hero-inner { padding-left: 26px; } }
  @media (max-width: 1024px) {
    .hero-main { min-height: auto; }
    .hero-inner { padding-top: 48px; padding-bottom: 48px; }
  }

  .hero-card {
    max-width: 980px;
    padding: 28px 28px;
    background: transparent;
    border: 0;
    box-shadow: none;
    margin-top: clamp(-60px, -4vh, -12px);
    margin-left: 0;
    animation: fadeUp 820ms cubic-bezier(.2,.7,.2,1) both;
  }
  .hero-card.flow > * + * { margin-top: 12px; }

  @media (max-width: 768px) { .hero-card { padding: 22px 18px; } }
  @media (prefers-reduced-motion: reduce) { .hero-card { animation: none; } }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(26px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Typo */
  .h1-hero {
    color: #fff;
    line-height: 1.08;
    font-weight: 600;
    font-size: clamp(26px, 3vw + 14px, 46px);
    letter-spacing: .04px;
    text-wrap: balance;
    text-shadow: 0 1px 8px rgba(0,0,0,.14);
  }
  .h1-line { display: block; }

  .brand-text {
    color: var(--brand);
    font-weight: 800;
    letter-spacing: .25px;
    font-size: 1.35em;
    text-shadow: 0 2px 12px rgba(0,0,0,.28);
  }
  @media (min-width: 900px) { .brand-text { font-size: 1.5em; } }

  .hero-lead {
    color: #eef4f1;
    font-size: clamp(15px, 1.2vw + 12px, 18px);
    line-height: 1.65;
    max-width: 900px;
    text-shadow: 0 1px 8px rgba(0,0,0,.12);
  }

  .claim {
    color: #cfe7d5;
    font-size: clamp(16px, 1vw + 12px, 20px);
    font-weight: 700;
    letter-spacing: .2px;
  }

  /* Geo highlight */
  .geo {
    background-image: linear-gradient(transparent 62%, rgba(54,145,66,.32) 62%);
    background-repeat: no-repeat;
    background-size: 100% 100%;
    padding: 0 .06em;
    border-radius: .1em;
    font-weight: 700;
  }
  @media (hover: hover) {
    .geo:hover {
      background-image: linear-gradient(transparent 50%, rgba(54,145,66,.45) 50%);
    }
  }

  /* CTAs */
  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; }

  .btn-primary {
    background: var(--brand);
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    padding: 14px 18px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform .15s ease, filter .2s, box-shadow .2s;
    box-shadow: 0 6px 20px rgba(54,145,66,.28);
  }
  .btn-primary:hover { filter: brightness(0.95); transform: translateY(-2px); }

  .btn-ghost {
    background: rgba(255,255,255,.10);
    border: 1px solid rgba(255,255,255,.26);
    color: #fff;
    text-decoration: none;
    padding: 14px 18px;
    border-radius: 12px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: background .2s, border-color .2s, transform .15s;
  }
  .btn-ghost:hover {
    background: rgba(255,255,255,.16);
    border-color: rgba(255,255,255,.36);
    transform: translateY(-1px);
  }

  /* Trust Rail */
  .trust-rail {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    margin-top: 10px;
  }
  @media (min-width: 400px)  { .trust-rail { grid-template-columns: repeat(2,1fr); } }
  @media (min-width: 980px)  { .trust-rail { grid-template-columns: repeat(4,1fr); } }
  @media (max-width: 768px)  { .trust-rail { grid-template-columns: 1fr !important; } }

  .trust-badge {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 14px;
    border-radius: 16px;
    color: #fff;
    background: rgba(0,0,0,.18);
    border: 1px solid rgba(255,255,255,.28);
    box-shadow: 0 3px 14px rgba(0,0,0,.22);
    backdrop-filter: saturate(120%) blur(5px);
    -webkit-backdrop-filter: saturate(120%) blur(5px);
    transition: transform .18s ease, box-shadow .18s ease, background .18s ease, border-color .18s ease;
    overflow: hidden;
  }
  .trust-badge::after {
    content: "";
    position: absolute;
    inset: auto -10% -60% -10%;
    height: 140%;
    background: radial-gradient(60% 60% at 50% 0%, rgba(255,255,255,.22), rgba(255,255,255,0));
    transform: translateY(-10%);
    pointer-events: none;
  }
  .trust-badge:hover {
    transform: translateY(-2px);
    background: rgba(255,255,255,.14);
    border-color: rgba(255,255,255,.36);
    box-shadow: 0 8px 22px rgba(0,0,0,.32);
  }

  .trust-ico {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--brand), var(--brand-2));
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.22), 0 3px 10px rgba(0,0,0,.25);
  }
  .trust-ico svg, .trust-ico text {
    width: 20px;
    height: 20px;
    color: #fff;
    fill: currentColor;
  }

  .trust-txt { display: flex; flex-direction: column; gap: 0; line-height: 1.25; }
  .trust-title { font-weight: 800; font-size: 15px; letter-spacing: .2px; line-height: 1.25; }
  .trust-sub   { font-weight: 700; font-size: 13px; opacity: .92; line-height: 1.25; }

  .stars { display: inline-flex; gap: 2px; margin-left: 6px; vertical-align: middle; }
  .star { font-size: 12px; color: #FFD166; }
</style>
