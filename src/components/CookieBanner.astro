---
---
<div id="cookie-banner">
  <p class="cb-text">
    Wir verwenden Cookies, um grundlegende Funktionen bereitzustellen.
    Optionale Cookies (z. B. Google reCAPTCHA v3) werden nur mit Ihrer Einwilligung geladen.
    <a href="/datenschutz">Datenschutzerklärung</a>
  </p>

  <div class="cb-options">
    <div class="cb-option">
      <strong>Notwendig</strong>
      <label class="switch">
        <input type="checkbox" checked disabled />
        <span class="slider"></span>
      </label>
    </div>
    <div class="cb-option">
      <strong>Statistik</strong>
      <label class="switch">
        <input type="checkbox" id="cb-stat" />
        <span class="slider"></span>
      </label>
    </div>
    <div class="cb-option">
      <strong>Marketing</strong>
      <label class="switch">
        <input type="checkbox" id="cb-mark" />
        <span class="slider"></span>
      </label>
    </div>
  </div>

  <div class="cb-actions">
    <button class="btn-main" id="cbAcceptBtn">Alle akzeptieren</button>
    <button class="btn-alt"  id="cbSaveBtn">Auswahl speichern</button>
    <button class="btn-ghost" id="cbRejectBtn">Ablehnen</button>
  </div>
</div>

<style>
  #cookie-banner {
    --green-main: #4CAF50;
    --green-soft: #E9F6EC;
    --green-light: #F4FBF6;
    --text-dark: #1f2d24;
    --border: #d8eede;

    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    position: fixed;
    left: 0; right: 0; bottom: 0;
    max-width: 1000px; margin: auto;
    background: linear-gradient(180deg, var(--green-light), var(--green-soft));
    border-top: 4px solid var(--green-main);
    border-radius: 22px 22px 0 0;
    padding: 26px;
    color: var(--text-dark);
    box-shadow: 0 -10px 30px rgba(0,0,0,.15);
    z-index: 9999;
    display: none;
  }

  #cookie-banner .cb-text { font-size: 15px; line-height: 1.6; }
  #cookie-banner .cb-text a { color: var(--green-main); font-weight: 500; }

  #cookie-banner .cb-options { display: grid; gap: 14px; margin: 22px 0; }
  #cookie-banner .cb-option {
    display: flex; justify-content: space-between; align-items: center;
    background: #fff; border: 1px solid var(--border);
    padding: 14px 16px; border-radius: 14px;
  }

  #cookie-banner .switch { position: relative; width: 44px; height: 24px; }
  #cookie-banner .switch input { opacity: 0; width: 0; height: 0; }

  #cookie-banner .slider {
    position: absolute; inset: 0; background: #dbeee0;
    border-radius: 30px; cursor: pointer; transition: .3s;
  }
  #cookie-banner .slider:before {
    content: ""; position: absolute;
    width: 18px; height: 18px; left: 3px; top: 3px;
    background: #fff; border-radius: 50%; transition: .3s;
  }
  #cookie-banner input:checked + .slider { background: var(--green-main); }
  #cookie-banner input:checked + .slider:before { transform: translateX(20px); }

  #cookie-banner .cb-actions { display: flex; flex-direction: column; gap: 12px; }
  #cookie-banner .cb-actions button {
    padding: 14px; font-size: 15px; font-weight: 600;
    border-radius: 14px; border: none; cursor: pointer;
    font-family: inherit;
  }
  #cookie-banner .btn-main  { background: var(--green-main); color: #fff; }
  #cookie-banner .btn-alt   { background: #fff; color: var(--green-main); border: 1px solid var(--green-main) !important; }
  #cookie-banner .btn-ghost { background: transparent; color: #4a6b56; }
</style>

<script>
  const CB_KEY = 'cookieConsent';
  const banner = document.getElementById('cookie-banner');

  function hideBanner() { if (banner) banner.style.display = 'none'; }

  document.getElementById('cbAcceptBtn')?.addEventListener('click', () => {
    localStorage.setItem(CB_KEY, JSON.stringify({ stat: true, mark: true }));
    hideBanner();
  });
  document.getElementById('cbSaveBtn')?.addEventListener('click', () => {
    localStorage.setItem(CB_KEY, JSON.stringify({
      stat: (document.getElementById('cb-stat') as HTMLInputElement)?.checked ?? false,
      mark: (document.getElementById('cb-mark') as HTMLInputElement)?.checked ?? false,
    }));
    hideBanner();
  });
  document.getElementById('cbRejectBtn')?.addEventListener('click', () => {
    localStorage.setItem(CB_KEY, JSON.stringify({ stat: false, mark: false }));
    hideBanner();
  });

  window.addEventListener('load', () => {
    if (!localStorage.getItem(CB_KEY) && banner) banner.style.display = 'block';
  });
</script>
