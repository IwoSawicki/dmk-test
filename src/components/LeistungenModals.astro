<!-- Modal: Innenausbau -->
<div class="innenausbau-modal" id="innenausbau-modal" aria-hidden="true">
  <div class="innenausbau-dialog" role="dialog" aria-modal="true" aria-labelledby="innenausbau-title">
    <button class="innen-close" type="button" aria-label="Auswahl schließen">&times;</button>
    <header class="innen-header">
      <div class="innen-kicker">Ihre Auswahl</div>
      <h2 class="innen-title" id="innenausbau-title">Welche Leistung im Innenausbau interessiert Sie?</h2>
      <div class="innen-accent"></div>
    </header>
    <section class="innen-card">
      <nav class="innen-gewerke-nav" aria-label="Innenausbau Gewerke">
        {[
          { href: "/trockenbau", title: "Trockenbau", teaser: "Leichte Innenwände, Decken, Schallschutz und flexible Raumaufteilung." },
          { href: "/estricharbeiten", title: "Estricharbeiten", teaser: "Solide Basis für alle Bodenbeläge – eben, tragfähig und fachgerecht verlegt." },
          { href: "/fenster-tueren-montage-reichelsheim-odenwald", title: "Fenster- & Türeinbau", teaser: "Mehr Licht, Sicherheit und Energieeffizienz durch präzise Montage." },
          { href: "/treppenbau", title: "Treppenbau", teaser: "Sichere und optisch stimmige Verbindung der Etagen – passend zu Ihrem Stil." },
          { href: "/fliesenarbeiten", title: "Fliesenarbeiten", teaser: "Präzise verlegte Fliesen für Bäder, Küchen, Wohnräume und Treppen." },
          { href: "/putzarbeiten", title: "Putzarbeiten", teaser: "Glatt, strukturiert oder kreativ – wir schaffen die Basis für perfekte Wände." },
          { href: "/montagearbeiten", title: "Fertigbauteile", teaser: "Clever vorgefertigte Elemente, sauber integriert und exakt montiert." },
          { href: "/barrierefreies-bauen", title: "Barrierefreies Bauen", teaser: "Komfortabel und sicher wohnen – mit durchdachten, schwellenlosen Lösungen." },
        ].map(item => (
          <a class="innen-link" href={item.href}>
            <div class="innen-dot-wrap"><div class="innen-dot"></div></div>
            <div class="innen-text">
              <span class="innen-link-title">{item.title}</span>
              <span class="innen-link-teaser">{item.teaser}</span>
            </div>
            <span class="innen-chevron">›</span>
          </a>
        ))}
      </nav>
    </section>
  </div>
</div>

<!-- Modal: Badsanierung -->
<div class="innenausbau-modal" id="bad-modal" aria-hidden="true">
