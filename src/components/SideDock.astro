<style>
  #dmk-side-dock {
    --green1: #3A7D44;
    --green2: #2E6C3A;
    --panel-bg-1: rgba(255,255,255,0.60);
    --panel-bg-2: rgba(255,255,255,0.38);
    --shadow-dark: rgba(0,0,0,0.25);
    --ink: #0f172a;
    --ink-soft: #374151;
  }

  #dmk-side-dock .kontakt-dock {
    position: fixed;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    z-index: 10000;
    font-family: "Quicksand", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  }

  #dmk-side-dock .ask-btn {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 10px 6px 14px;
    border: 0;
    background: rgba(17,24,39,0.88);
    color: white;
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 0 12px 24px rgba(0,0,0,0.28);
  }
  #dmk-side-dock .ask-btn__label { font-weight: 500; font-size: 14px; letter-spacing: .2px; }
  #dmk-side-dock .ask-btn__bubble {
    display: grid; place-items: center;
    width: 44px; height: 44px; border-radius: 999px;
    font-weight: 700; font-size: 18px; line-height: 1;
    background: linear-gradient(135deg, var(--green1), var(--green2));
    color: #fff;
    box-shadow: 0 10px 22px rgba(46,108,58,0.35), inset 0 1px 0 rgba(255,255,255,0.35), inset 0 -3px 8px rgba(0,0,0,0.12);
    transition: transform .18s ease, filter .18s ease, box-shadow .18s ease;
  }
  #dmk-side-dock .ask-btn:hover .ask-btn__bubble {
    transform: translateY(-1px) scale(1.03);
    filter: saturate(110%);
    box-shadow: 0 14px 28px rgba(46,108,58,0.38), inset 0 1px 0 rgba(255,255,255,0.4), inset 0 -3px 8px rgba(0,0,0,0.12);
  }

  #dmk-side-dock .dock-panel {
    position: fixed;
    right: 0;
    top: 50%;
    transform: translateY(-50%) translateX(100%);
    opacity: 0;
    visibility: hidden;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 320px;
    background: linear-gradient(180deg, var(--panel-bg-1), var(--panel-bg-2));
    border-radius: 20px 0 0 20px;
    padding: 18px 16px;
    box-shadow: -18px 18px 40px var(--shadow-dark);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    transition: transform .35s ease, opacity .25s ease, visibility .25s step-end;
    border-left: 1px solid rgba(0,0,0,0.06);
    outline: 1px solid rgba(255,255,255,0.35);
  }
  #dmk-side-dock .kontakt-dock.open .dock-panel {
    transform: translateY(-50%) translateX(0);
    opacity: 1;
    visibility: visible;
    transition: transform .35s ease, opacity .25s ease, visibility 0s;
  }

  #dmk-side-dock .dock-item {
    display: flex; align-items: center; gap: 12px;
    text-decoration: none; color: var(--ink-soft);
    font-weight: 400; font-size: 14px;
    padding: 11px 14px; border-radius: 16px;
    background: linear-gradient(145deg, rgba(255,255,255,0.96), rgba(255,255,255,0.72));
    box-shadow: 6px 10px 18px rgba(0,0,0,0.08), -6px -6px 12px rgba(255,255,255,0.55);
    transition: transform .18s ease, box-shadow .18s ease, color .18s ease;
  }
  #dmk-side-dock .dock-item:hover {
    transform: translateX(-2px);
    color: #255838;
    box-shadow: 10px 14px 22px rgba(0,0,0,0.10), -6px -6px 12px rgba(255,255,255,0.55);
  }

  #dmk-side-dock .chip {
    position: relative; display: grid; place-items: center;
    width: 34px; height: 34px; border-radius: 999px;
    background: linear-gradient(180deg, rgba(255,255,255,0.76), rgba(255,255,255,0.56));
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.5), inset 0 -2px 6px rgba(0,0,0,0.06);
    flex-shrink: 0;
  }
  #dmk-side-dock .chip::before {
    content: ""; position: absolute; inset: 0; border-radius: inherit;
    background: conic-gradient(from 210deg, #3A7D44, #2E6C3A, #3A7D44);
    -webkit-mask: radial-gradient(circle at center, transparent 56%, #000 57%);
    mask: radial-gradient(circle at center, transparent 56%, #000 57%);
    opacity: .55; transition: opacity .18s ease, filter .18s ease;
  }
  #dmk-side-dock .dock-item:hover .chip::before { opacity: .9; filter: saturate(112%); }
  #dmk-side-dock .chip svg { width: 18px; height: 18px; }
  #dmk-side-dock .txt { line-height: 1.3; }

  @media (max-width: 768px) {
    #dmk-side-dock .ask-btn__bubble { width: 42px; height: 42px; font-size: 17px; }
    #dmk-side-dock .ask-btn__label { font-size: 13px; }
    #dmk-side-dock .dock-panel { min-width: 300px; }
  }
</style>

<script>
  const dock   = document.querySelector<HTMLElement>('#dmk-side-dock #kontaktDock');
  const toggle = document.querySelector<HTMLButtonElement>('#dmk-side-dock #dockToggle');

  toggle?.addEventListener('click', () => {
    dock?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(dock?.classList.contains('open')));
  });

  document.addEventListener('click', (e) => {
    if (!dock?.contains(e.target as Node) && dock?.classList.contains('open')) {
      dock.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
