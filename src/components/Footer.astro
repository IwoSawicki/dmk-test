        </a>
      </div>
    </section>
  </div>

  <div class="dmk-copy">
    <span>©{year} DMK Bau</span>
    <span>Created by <a href="https://webpage-seo.de" rel="noopener noreferrer" target="_blank">webpage-seo.de</a></span>
  </div>
</footer>

<style>
  footer.dmk-footer {
    background: #ffffff;
    border-top: 1px solid #eef2ee;
    padding: 48px 20px 24px;
    font-family: "Quicksand", sans-serif;
    color: #1f1f1f;
  }
  .dmk-foot-wrap {
    max-width: 1200px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr; gap: 32px; position: relative;
  }
  @media (min-width: 820px) {
    .dmk-foot-wrap { grid-template-columns: repeat(4, 1fr); }
    .dmk-foot-wrap::before,
    .dmk-foot-wrap::after,
    .dmk-foot-wrap section:nth-of-type(4)::before {
      content: ""; position: absolute; top: 0; bottom: 0;
      width: 1px; background: #e9eee9;
    }
    .dmk-foot-wrap::before { left: calc(25% - 0.5px); }
    .dmk-foot-wrap::after  { left: calc(50% - 0.5px); }
    .dmk-foot-wrap section:nth-of-type(4)::before { left: calc(75% - 0.5px); }
  }

  .dmk-foot h4 {
    font-weight: 700; font-size: 18px; margin-bottom: 14px;
    background: linear-gradient(90deg, #3A7D44, #2E6C3A);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  }
  .dmk-list { list-style: none; display: grid; gap: 10px; }
  .dmk-link {
    text-decoration: none; color: #2a2f2b; font-weight: 600;
    display: inline-block; transition: all .25s ease;
  }
  .dmk-link:hover { color: #3A7D44; transform: translateY(-2px) scale(1.1); }

  .dmk-contact { display: grid; gap: 10px; color: #2b2f2c; }
  .dmk-row { display: flex; align-items: flex-start; gap: 10px; }
  .dmk-ico {
    width: 20px; height: 20px; flex: 0 0 20px;
    display: inline-flex; align-items: center; justify-content: center;
    color: #3A7D44;
  }
  .dmk-contact a { color: #3A7D44; text-decoration: none; font-weight: 700; }
  .dmk-contact a:hover { text-decoration: underline; }

  .dmk-social { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; }
  .dmk-sbtn {
    width: 56px; height: 56px; border-radius: 16px;
    background: linear-gradient(145deg, #ffffff, #e9efe9);
    box-shadow: 6px 6px 12px #d9ded9, -6px -6px 12px #ffffff;
    display: flex; align-items: center; justify-content: center;
    transition: all .25s ease; color: #2E6C3A;
    position: relative; overflow: hidden;
  }
  .dmk-sbtn svg { width: 32px; height: 24px; z-index: 2; }
  .dmk-sbtn .label {
    position: absolute; left: 65px; opacity: 0; white-space: nowrap;
    color: #2E6C3A; font-weight: 700; transition: all .25s ease; transform: translateX(-10px);
  }
  .dmk-sbtn:hover {
    transform: translateY(-4px);
    box-shadow: 4px 4px 10px rgba(58,125,68,.25), -4px -4px 10px #ffffff;
    background: linear-gradient(145deg, #f1f6f2, #ffffff);
    color: #3A7D44;
  }
  .dmk-sbtn:hover .label { opacity: 1; transform: translateX(0); }
  .dmk-sbtn:active { transform: translateY(0); box-shadow: inset 3px 3px 6px #d9ded9, inset -3px -3px 6px #ffffff; }

  .dmk-copy {
    max-width: 1200px; margin: 32px auto 0; padding-top: 18px;
    border-top: 1px solid #eef2ee;
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;
    font-size: 14px; font-weight: 600; color: #4d534e;
  }
  .dmk-copy a { color: #3A7D44; text-decoration: none; font-weight: 700; }
  .dmk-copy a:hover { text-decoration: underline; }
</style>
