          <div>Mo–Fr: <strong>09:00–17:00</strong><br />Sa–So: <strong>Geschlossen</strong></div>
        </div>
      </div>
    </section>

    <section class="dmk-foot">
      <h4>Social Media</h4>
      <div class="dmk-social">
        <a aria-label="Facebook" class="dmk-sbtn" href="https://www.facebook.com/people/DMK-bau/100057634561646/" rel="noopener" target="_blank">
          <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24">
