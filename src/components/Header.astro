---
---
<header>
  <nav class="nav-wrap" aria-label="Hauptnavigation">
    <a href="/" class="nav-logo">
      <img src="/images/dmk-bau-firmenlogo-reichelsheim-odenwald-1.webp"
           alt="DMK Bau Logo" width="auto" height="42" />
    </a>

    <button class="nav-toggle" aria-label="Hauptmenü öffnen" aria-expanded="false" type="button">
      <span class="nav-toggle-box">
        <span class="nav-toggle-bar"></span>
      </span>
    </button>

    <div class="menu" id="primary-nav">
      <a class="nav-link" href="/#unternehmen">Unternehmen</a>
      <a class="nav-link" href="/#dmk-sec3">Leistungen</a>
      <a class="nav-link" href="/#dmk-sec6">Kontaktformular</a>
      <a class="call-display" href="tel:01607791280" aria-label="Jetzt anrufen: 0160 7791280">
        <svg aria-hidden="true" fill="none" height="18" stroke="currentColor"
             stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
             viewBox="0 0 24 24" width="18">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6
                   19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.3 1.78.54 2.64
                   a2 2 0 0 1-.45 2.11L8 9a16 16 0 0 0 7 7l.53-1.2a2 2 0 0 1 2.11-.45c.86.24 1.74.42 2.64.54A2 2 0 0 1 22 16.92z"></path>
        </svg>
        0160 7791280
      </a>
    </div>
  </nav>
</header>

<style>
  header {
    background: var(--brand);
    position: sticky;
    top: 0;
    z-index: 200;
    box-shadow: 0 1px 6px rgba(0,0,0,.06);
  }

  .nav-wrap {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 18px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    position: relative;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    margin-right: auto;
  }
  .nav-logo img {
    height: 42px;
    width: auto;
    display: block;
  }

  .menu {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .nav-link {
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    opacity: 0.9;
    transition: opacity 0.16s;
  }
  .nav-link:hover { opacity: 0.8; }

  .call-display {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    color: #000000;
    padding: 8px 14px;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 600;
    transition: background .2s;
  }
  .call-display svg { stroke: #000000; }
  .call-display:hover { background: #f4f4f4; }

  /* Burger button – hidden on desktop */
  .nav-toggle {
    display: none;
    margin-left: auto;
    background: transparent;
    border: 0;
    padding: 7px;
    border-radius: 999px;
    cursor: pointer;
    transform: translateY(0);
    transition: transform .16s ease;
  }
  .nav-toggle:hover { transform: translateY(-1px); }
  .nav-toggle:active { transform: translateY(1px); }
  .nav-toggle:focus-visible { outline: 3px solid rgba(255,255,255,.85); outline-offset: 3px; }

  .nav-toggle-box {
    position: relative;
    width: 32px;
    height: 24px;
    display: inline-block;
  }

  .nav-toggle-bar,
  .nav-toggle-bar::before,
  .nav-toggle-bar::after {
    content: "";
    position: absolute;
    left: 0; right: 0;
    height: 3px;
    background: #ffffff;
    border-radius: 999px;
  }
  .nav-toggle-bar { top: 50%; transform: translateY(-50%); }
  .nav-toggle-bar::before { top: -8px; }
  .nav-toggle-bar::after { bottom: -8px; }

  /* ===== Mobile / Tablet (≤1024px) ===== */
  @media (max-width: 1024px) {
    .nav-toggle { display: inline-flex; align-items: center; justify-content: center; }

    header .nav-wrap {
      height: 60px;
      padding-top: 8px;
      padding-bottom: 8px;
      justify-content: space-between;
      align-items: center;
      flex-wrap: nowrap;
    }

    header .menu {
      position: absolute;
      left: 12px;
      right: 12px;
      top: 100%;
      margin-top: 8px;
      background: linear-gradient(145deg, rgba(0,0,0,.24), rgba(0,0,0,.32));
      backdrop-filter: blur(18px);
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      padding: 12px 14px 14px;
      border-radius: 18px;
      box-shadow: 0 20px 38px rgba(0,0,0,.5);
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      pointer-events: none;
      transform: translateY(-8px) translateZ(0);
      transition: max-height .26s ease, opacity .2s ease, transform .22s ease;
    }
    header .menu.open {
      max-height: 260px;
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0) translateZ(0);
    }
    header .menu .nav-link {
      width: 100%;
      padding: 8px 4px;
      border-radius: 12px;
      position: relative;
      overflow: hidden;
      transform: translateX(0);
      transition: background .18s ease, transform .18s ease, box-shadow .18s ease;
    }
    header .menu .nav-link:hover {
      background: rgba(255,255,255,.09);
      transform: translateX(4px);
      box-shadow: 0 6px 14px rgba(0,0,0,.45);
    }
    header .menu .call-display {
      width: 100%;
      justify-content: center;
      margin-top: 4px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const toggle = document.querySelector('.nav-toggle');
    const menu = document.getElementById('primary-nav');
    if (!toggle || !menu) return;

    function closeMenu() {
      menu.classList.remove('open');
      toggle.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
    }

    toggle.addEventListener('click', function () {
      const isOpen = !menu.classList.contains('open');
      if (isOpen) {
        menu.classList.add('open');
        toggle.classList.add('open');
        toggle.setAttribute('aria-expanded', 'true');
      } else {
        closeMenu();
      }
    });

    menu.querySelectorAll('.nav-link').forEach(function (link) {
      link.addEventListener('click', function () {
        if (window.innerWidth <= 1024) closeMenu();
      });
    });

    window.addEventListener('resize', function () {
      if (window.innerWidth > 1024 && menu.classList.contains('open')) closeMenu();
    });
  });
</script>
